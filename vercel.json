{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": {
        "service": "backend",
        "path": "/api/:match*"
      }
    },
    {
      "source": "/((?!api/).*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
